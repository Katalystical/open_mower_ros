<launch>
    <arg name="enabled" default="true"/>
    <arg name="topic_name" default="scan"/>
    <arg name="frame_id" default="base_laser"/>
    <arg name="port_name" default="/dev/ttyUSB0"/>
    <arg name="port_baudrate" default="230400"/>
    <arg name="fix_to_base_link" default="true"/>
    <arg name="x" default="$(optenv OM_LD19_X 0.0)"/>
    <arg name="y" default="$(optenv OM_LD19_Y 0.0)"/>
    <arg name="z" default="$(optenv OM_LD19_Z 0.18)"/>
    <arg name="yaw" default="$(optenv OM_LD19_YAW 0.0)"/>
    <arg name="pitch" default="$(optenv OM_LD19_PITCH 0.0)"/>
    <arg name="roll" default="$(optenv OM_LD19_ROLL 0.0)"/>

    <group if="$(arg enabled)">
        <arg name="checked_x" value="$(eval float(arg('x')) if isfinite(float(arg('x'))) else float('LD19 x must be finite'))"/>
        <arg name="checked_y" value="$(eval float(arg('y')) if isfinite(float(arg('y'))) else float('LD19 y must be finite'))"/>
        <arg name="checked_z" value="$(eval float(arg('z')) if isfinite(float(arg('z'))) else float('LD19 z must be finite'))"/>
        <arg name="checked_yaw" value="$(eval float(arg('yaw')) if isfinite(float(arg('yaw'))) else float('LD19 yaw must be finite'))"/>
        <arg name="checked_pitch" value="$(eval float(arg('pitch')) if isfinite(float(arg('pitch'))) else float('LD19 pitch must be finite'))"/>
        <arg name="checked_roll" value="$(eval float(arg('roll')) if isfinite(float(arg('roll'))) else float('LD19 roll must be finite'))"/>
        <node name="LD19" pkg="open_mower" type="ld19_availability.py" output="screen">
            <param name="product_name" value="LDLiDAR_LD19"/>
            <param name="topic_name" value="$(arg topic_name)"/>
            <param name="frame_id" value="$(arg frame_id)"/>
            <param name="port_name" value="$(arg port_name)"/>
            <param name="port_baudrate" value="$(arg port_baudrate)"/>
            <param name="laser_scan_dir" type="bool" value="true"/>
            <param name="enable_angle_crop_func" type="bool" value="false"/>
            <param name="angle_crop_min" type="double" value="135.0"/>
            <param name="angle_crop_max" type="double" value="225.0"/>
        </node>

        <node name="base_to_laser" pkg="tf" type="static_transform_publisher"
              args="$(arg checked_x) $(arg checked_y) $(arg checked_z) $(arg checked_yaw) $(arg checked_pitch) $(arg checked_roll) base_link base_laser 50"
              if="$(arg fix_to_base_link)"/>
    </group>
</launch>
